[
  {
    "name": "pure ASCII: one byte per character, no highlights",
    "input": { "text": "Hi" },
    "expect": {
      "kind": "group",
      "parts": [
        {
          "kind": "fields",
          "fields": [
            { "label": "Bytes", "value": "2" },
            { "label": "Characters", "value": "2", "note": "code points, not UTF-16 units" },
            { "label": "Encoding", "value": "pure ASCII", "tone": "good" },
            { "label": "Overhead", "value": "0 bytes", "note": "what UTF-8 costs over one byte per character" }
          ]
        },
        { "kind": "bytes", "bytes": [72, 105], "caption": "Every character is one byte" }
      ]
    }
  },
  {
    "name": "two, three and four-byte characters, offsets hand-verified against RFC 3629",
    "input": { "text": "Héllo, 世界 👋" },
    "expect": {
      "kind": "group",
      "parts": [
        {
          "kind": "fields",
          "fields": [
            { "label": "Bytes", "value": "19" },
            { "label": "Characters", "value": "11", "note": "code points, not UTF-16 units" },
            { "label": "Encoding", "value": "4 multi-byte" },
            { "label": "Overhead", "value": "8 bytes", "note": "what UTF-8 costs over one byte per character" }
          ]
        },
        {
          "kind": "bytes",
          "bytes": [72, 195, 169, 108, 108, 111, 44, 32, 228, 184, 150, 231, 149, 140, 32, 240, 159, 145, 139],
          "caption": "Highlighted runs are one character each",
          "highlight": [
            { "at": 1, "len": 2, "label": "U+00E9 é" },
            { "at": 8, "len": 3, "label": "U+4E16 世" },
            { "at": 11, "len": 3, "label": "U+754C 界" },
            { "at": 15, "len": 4, "label": "U+1F44B 👋" }
          ]
        }
      ]
    }
  },
  {
    "name": "a four-byte character alone: the highlight starts at offset 0",
    "input": { "text": "👋" },
    "expect": {
      "kind": "group",
      "parts": [
        {
          "kind": "fields",
          "fields": [
            { "label": "Bytes", "value": "4" },
            { "label": "Characters", "value": "1", "note": "code points, not UTF-16 units" },
            { "label": "Encoding", "value": "1 multi-byte" },
            { "label": "Overhead", "value": "3 bytes", "note": "what UTF-8 costs over one byte per character" }
          ]
        },
        {
          "kind": "bytes",
          "bytes": [240, 159, 145, 139],
          "caption": "Highlighted runs are one character each",
          "highlight": [{ "at": 0, "len": 4, "label": "U+1F44B 👋" }]
        }
      ]
    }
  },
  {
    "name": "a combining mark counts as its own code point, which is the honest caveat",
    "input": { "text": "é" },
    "expect": {
      "kind": "group",
      "parts": [
        {
          "kind": "fields",
          "fields": [
            { "label": "Bytes", "value": "3" },
            { "label": "Characters", "value": "2", "note": "code points, not UTF-16 units" },
            { "label": "Encoding", "value": "1 multi-byte" },
            { "label": "Overhead", "value": "1 byte", "note": "what UTF-8 costs over one byte per character" }
          ]
        },
        {
          "kind": "bytes",
          "bytes": [101, 204, 129],
          "caption": "Highlighted runs are one character each",
          "highlight": [{ "at": 1, "len": 2, "label": "U+0301 ́" }]
        }
      ]
    }
  },
  {
    "name": "empty input is an error, not an empty dump",
    "input": { "text": "" },
    "expect": { "kind": "error", "message": "Nothing to encode. Type some text.", "input": "text" }
  }
]
