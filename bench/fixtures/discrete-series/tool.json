{
	"sdk": 4,
	"id": "discrete-series",
	"name": "Discrete series",
	"blurb": "Draws each chart shape that once misled over whole-number x values, so the renderer's answer to each is on screen.",
	"version": "1.0.0",
	"capabilities": ["pure"],
	"runtime": { "entry": "index.ts", "thread": "main" },
	"autoRun": true,
	"card": "live",
	"kinds": ["series", "group", "table", "heatmap", "pie", "radar", "treemap", "venn", "error"],
	"tags": ["bench"],
	"inputs": [
		{
			"id": "case",
			"type": "select",
			"label": "Case",
			"description": "Each is one defect from issue 111, drawn with the data that exposed it.",
			"primary": true,
			"default": "lines",
			"options": [
				{ "value": "lines", "label": "Lines over frames 1 to 20" },
				{ "value": "area", "label": "An area under a line" },
				{ "value": "histogram", "label": "A histogram" },
				{ "value": "combo", "label": "Bars, a line and markers, two axes" },
				{ "value": "two-bars", "label": "Two bar series" },
				{ "value": "zero-bars", "label": "A bar series of zeros" },
				{ "value": "signed-bars", "label": "Bars either side of zero" },
				{ "value": "markers", "label": "Lines with markers" },
				{ "value": "points", "label": "Points, no lines" },
				{ "value": "readout", "label": "A readout the tool writes" },
				{ "value": "linked", "label": "A chart linked to a table" },
				{ "value": "categories", "label": "Bars over named categories" },
				{ "value": "many-categories", "label": "Twenty-four categories" },
				{ "value": "thresholds", "label": "A line against two thresholds" },
				{ "value": "stacked", "label": "Stacked bars against a budget" },
				{ "value": "stacked-signed", "label": "A stack either side of zero, beside a plain bar" },
				{ "value": "horizontal", "label": "Horizontal stacked bars" },
				{ "value": "horizontal-grouped", "label": "Horizontal grouped bars, long names" },
				{ "value": "pyramid", "label": "A mirrored pyramid" },
				{ "value": "step", "label": "A step line beside a sloped one" },
				{ "value": "log", "label": "Both axes on a log scale" },
				{ "value": "log-zero", "label": "A log axis given a zero" },
				{ "value": "band", "label": "A median inside a p5 to p95 band" },
				{ "value": "scatter", "label": "Two series with their own x" },
				{ "value": "bubble", "label": "Bubbles: a third measure as size" },
				{ "value": "box", "label": "Box plots per network, two series" },
				{ "value": "heatmap", "label": "A heatmap, sequential" },
				{ "value": "heatmap-diverging", "label": "A heatmap, diverging around zero" },
				{ "value": "pie", "label": "A pie of four parts" },
				{ "value": "donut", "label": "A donut with its total" },
				{ "value": "pie-many", "label": "A pie of eight parts, folded to six" },
				{ "value": "donut-exploded", "label": "A donut with one slice pulled out" },
				{ "value": "pie-negative", "label": "A pie given a negative value" },
				{ "value": "radar", "label": "A radar of three networks" },
				{ "value": "treemap", "label": "A treemap of costs" },
				{ "value": "venn-two", "label": "A Venn of two sets" },
				{ "value": "venn-three", "label": "A Venn of three sets" },
				{ "value": "venn-impossible", "label": "A Venn whose numbers cannot be true" }
			]
		}
	]
}
