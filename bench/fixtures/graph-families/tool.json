{
	"sdk": 7,
	"id": "graph-families",
	"name": "Graph families",
	"blurb": "Draws each graph family the layout is held to, so the runtime's answer to each is on screen.",
	"version": "1.0.0",
	"capabilities": [
		"pure"
	],
	"runtime": {
		"entry": "index.ts",
		"thread": "main"
	},
	"autoRun": true,
	"card": "live",
	"kinds": [
		"graph",
		"error"
	],
	"tags": [
		"bench"
	],
	"inputs": [
		{
			"id": "case",
			"type": "select",
			"label": "Graph",
			"description": "One family each, the graphs the layout's tests hold it to.",
			"primary": true,
			"default": "flowchart",
			"options": [
				{
					"value": "flowchart",
					"label": "Flowchart"
				},
				{
					"value": "state-orthogonal",
					"label": "State machine, orthogonal"
				},
				{
					"value": "state-spline",
					"label": "State machine, spline"
				},
				{
					"value": "deps-orthogonal",
					"label": "Dependency DAG, orthogonal"
				},
				{
					"value": "deps-spline",
					"label": "Dependency DAG, spline"
				},
				{
					"value": "org",
					"label": "Org chart"
				},
				{
					"value": "network-straight",
					"label": "Network, straight"
				},
				{
					"value": "network-orthogonal",
					"label": "Network, orthogonal"
				},
				{
					"value": "er",
					"label": "Entity-relationship"
				},
				{
					"value": "mind",
					"label": "Mind map"
				},
				{
					"value": "lanes",
					"label": "Swimlanes"
				},
				{
					"value": "nested",
					"label": "Nested groups"
				},
				{
					"value": "calls-orthogonal",
					"label": "Dense call graph, orthogonal"
				},
				{
					"value": "calls-spline",
					"label": "Dense call graph, spline"
				},
				{
					"value": "directions-lr",
					"label": "Pipeline, LR"
				},
				{
					"value": "directions-rl",
					"label": "Pipeline, RL"
				},
				{
					"value": "directions-tb",
					"label": "Pipeline, TB"
				},
				{
					"value": "directions-bt",
					"label": "Pipeline, BT"
				},
				{
					"value": "bipartite",
					"label": "Bipartite"
				},
				{
					"value": "nested-collapsed",
					"label": "Nested groups, one closed"
				},
				{
					"value": "dangling",
					"label": "A dangling edge, refused"
				},
				{
					"value": "limits",
					"label": "Past the tool's own limits"
				},
				{
					"value": "injected",
					"label": "An unknown colour, drawn in the default"
				}
			]
		}
	]
}
