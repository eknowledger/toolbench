{
  "name": "@toolbench/runtime",
  "version": "0.2.0",
  "description": "Renders and runs a Toolbench tool in any web page: a <tool-host> custom element with three display modes, no framework required.",
  "license": "MIT",
  "author": "Ahmed Elmalt",
  "homepage": "https://github.com/eknowledger/toolbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eknowledger/toolbench.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/eknowledger/toolbench/issues"
  },
  "keywords": [
    "toolbench",
    "web-components",
    "custom-elements",
    "shadow-dom",
    "web-worker",
    "interactive",
    "widget",
    "no-framework",
    "typescript",
    "zero-dependencies"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@toolbench/sdk": "workspace:^"
  }
}
