{
  "name": "toolbench-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "node --test \"packages/**/*.test.ts\" \"tools/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "new-tool": "node scripts/new-tool.mjs",
    "typecheck": "tsc -b packages/sdk packages/runtime && tsc --noEmit -p tools/tsconfig.json",
    "bench": "pnpm --filter @toolbench/bench dev",
    "bench:build": "pnpm --filter @toolbench/bench build",
    "check": "pnpm typecheck && pnpm test",
    "coverage": "node scripts/coverage.mjs",
    "test:bench": "node --test bench/*.test.ts",
    "size": "node scripts/size-check.mjs",
    "test:counts": "node scripts/test-counts.mjs",
    "measure:registry": "node scripts/measure-registry-source.mjs",
    "release": "pnpm build && changeset publish",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.1",
    "@changesets/cli": "2.29.8",
    "@types/node": "24.10.1",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  }
}
