{
  "name": "toolbench-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "node --test \"packages/**/*.test.ts\" \"tools/**/*.test.ts\" \"scripts/**/*.test.ts\" site/examples.test.ts",
    "new-tool": "node scripts/new-tool.mjs",
    "typecheck": "tsc -b packages/sdk packages/runtime && tsc --noEmit -p tools/tsconfig.json && tsc --noEmit -p bench/tsconfig.json && tsc --noEmit -p site/tsconfig.json",
    "bench": "pnpm --filter @toolbench/bench dev",
    "bench:build": "pnpm --filter @toolbench/bench build",
    "site": "pnpm --filter @toolbench/site dev",
    "site:build": "pnpm --filter @toolbench/site build",
    "site:diagrams": "node site/build/draw-diagrams.ts",
    "check": "pnpm typecheck && pnpm test",
    "coverage": "node scripts/coverage.mjs",
    "test:bench": "node --test bench/*.test.ts",
    "test:graph-scale": "node --test packages/runtime/test/graph-large.scale.ts",
    "test:site": "node --test site/*.test.ts",
    "size": "node scripts/size-check.mjs",
    "test:counts": "node scripts/test-counts.mjs",
    "measure:registry": "node scripts/measure-registry-source.mjs",
    "release": "pnpm build && changeset publish",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
